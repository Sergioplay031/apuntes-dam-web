rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.superadmin == true); }
    function superadmin() { return signedIn() && request.auth.token.superadmin == true; }
    function participant(chatId) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants; }
    function ticketAccess(ticketId) { return signedIn() && (admin() || get(/databases/$(database)/documents/tickets/$(ticketId)).data.ownerId == request.auth.uid); }
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['nombre','email','role'])
        && request.resource.data.keys().hasAll(['nombre','email','role'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 80
        && request.resource.data.email == request.auth.token.email && request.resource.data.role == 'student';
      allow update: if superadmin() || (owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','email'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 80
        && request.resource.data.email == request.auth.token.email);
      allow delete: if superadmin();
    }
    match /progress/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['completedLessons','completedExercises','lastLesson'])
        && request.resource.data.keys().hasAll(['completedLessons','completedExercises','lastLesson'])
        && request.resource.data.completedLessons is list && request.resource.data.completedLessons.size() <= 200
        && request.resource.data.completedExercises is list && request.resource.data.completedExercises.size() <= 200
        && request.resource.data.lastLesson is string && request.resource.data.lastLesson.size() <= 150;
      allow delete: if owner(uid) || superadmin();
    }
    // Directorio visible para usuarios autenticados: nunca guarda correos.
    match /directory/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['nombre'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 80;
      allow delete: if owner(uid) || superadmin();
    }
    match /chats/{chatId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['participants','updatedAt'])
        && request.resource.data.participants is list && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] is string && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];
      allow update: if participant(chatId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
      match /messages/{messageId} {
        allow read: if participant(chatId);
        allow create: if participant(chatId) && request.resource.data.keys().hasOnly(['senderId','text','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
      }
    }
    match /tickets/{ticketId} {
      allow get, list: if signedIn() && (admin() || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['ownerId','ownerName','subject','status','createdAt'])
        && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'abierto'
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 120
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 120;
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['abierto','resuelto'];
      match /messages/{messageId} {
        allow read: if ticketAccess(ticketId);
        allow create: if ticketAccess(ticketId) && request.resource.data.keys().hasOnly(['senderId','text','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 3000;
      }
    }
  }
}
